# Swamp runtime (ephemeral, regenerated by running workflows)
.swamp/data/
.swamp/outputs/
.swamp/workflow-runs/
.swamp/logs/
.swamp/files/
.swamp/telemetry/

# Swamp generated/evaluated files
.swamp/definitions-evaluated/
.swamp/workflows-evaluated/
.swamp/inputs-evaluated/

# Secrets and encryption (defense in depth — .key under vault too)
.swamp/secrets/
.swamp/vault/**/.key

# Symlink views (regenerated by swamp repo rebuild-index)
/models/
/workflows/
/vaults/
/resources/

# Claude Code (local settings, skills, tool config)
.claude/

# Environment files
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
